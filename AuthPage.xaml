<Page x:Class="MiracleBoots.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MiracleBoots"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" FontFamily="Calibri">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Вход в систему" FontSize="24" HorizontalAlignment="Center" Margin="5" FontWeight="Bold"/>
            <TextBlock Text="Логин" FontSize="20" Margin="5" HorizontalAlignment="Center"/>
            <TextBox Name="LoginBox" FontSize="14" Margin="5"/>
            <Button Name="EnterBtn" Content="Войти" Height="30" Margin="5" Click="EnterBtn_Click" FontWeight="Bold"/>
            <TextBlock Text="Не зарегистрированы?" FontSize="15" Margin="5" HorizontalAlignment="Center"/>
            <Button Name="GuestBtn" Content="Войти как гость" Height="30" Margin="5" Click="GuestBtn_Click" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Page>
