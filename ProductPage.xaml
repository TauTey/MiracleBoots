<Page x:Class="MiracleBoots.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MiracleBoots"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="1000"
      Title="ProductPage" FontFamily="Calibri" Background="#FFFFFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
            <TextBlock Name="FIOTB" FontSize="16" Margin="5"/>
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:" FontSize="16" Margin="5"/>
                <TextBox Name="TBoxSearch" Width="250" FontSize="14" TextChanged="TBoxSearch_TextChanged"/>
                <TextBlock Text="Категория:" FontSize="16" Margin="15,5,5,5"/>
                <ComboBox Name="ComboCategory" Width="150" FontSize="14" SelectionChanged="ComboCategory_SelectionChanged"/>
                <TextBlock Text="Сортировка:" FontSize="16" Margin="15,5,5,5"/>
                <RadioButton Name="RButtonUp" Content="По возрастанию" GroupName="Sort" FontSize="14" Margin="5" Checked="RButtonUp_Checked"/>
                <RadioButton Name="RButtonDown" Content="По убыванию" GroupName="Sort" FontSize="14" Margin="5" Checked="RButtonDown_Checked"/>
            </WrapPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Name="TBCount" FontSize="14" Margin="5"/>
            </StackPanel>
        </StackPanel>
        
        <ListView Name="ProductListView" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition Width="50"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Image Margin="5" Grid.Column="0" Grid.RowSpan="5" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image.Source>
                                <Binding Path="MainImagePath">
                                    <Binding.TargetNullValue>
                                        /Images/ЧудоОбувь.png
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <TextBlock Text="{Binding ProductName}" Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap"></TextBlock>
                        <TextBlock Text="{Binding CategorY, StringFormat=Тип: {0}}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" FontSize="13"></TextBlock>
                        <TextBlock Text="{Binding CategorY, StringFormat=Размерный ряд: {0}}" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left" FontSize="13"></TextBlock>
                        <TextBlock Text="{Binding ProductComposition}" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Left" FontSize="15" TextWrapping="Wrap"></TextBlock>
                        <TextBlock Text="{Binding ProductDescription}" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" HorizontalAlignment="Left" FontSize="15" TextWrapping="Wrap"></TextBlock>
                        <TextBlock Text="{Binding ProductCost, StringFormat=Цена &#10142; {0}}" Grid.Column="1" Grid.Row="4" Grid.ColumnSpan="2" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap"></TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
