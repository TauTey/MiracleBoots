<Page x:Class="MiracleBoots.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MiracleBoots"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="1000"
      Title="ProductPage" FontFamily="Calibri" Background="#FFFFFF">
    <Grid Background="#D2F6E7">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5">
            <TextBlock Name="FIOTB" FontSize="16" Margin="5"/>
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:" FontSize="16" Margin="5"/>
                <TextBox Name="TBoxSearch" Width="250" FontSize="14" TextChanged="TBoxSearch_TextChanged"/>
                <TextBlock Text="Категория:" FontSize="16" Margin="15,5,5,5"/>
                <ComboBox Name="ComboCategory" Width="150" FontSize="14" SelectionChanged="ComboCategory_SelectionChanged"/>
                <TextBlock Text="Сортировка:" FontSize="16" Margin="15,5,5,5"/>
                <RadioButton Name="RButtonUp" Content="По возрастанию" GroupName="Sort" FontSize="14" Margin="5" Checked="RButtonUp_Checked"/>
                <RadioButton Name="RButtonDown" Content="По убыванию" GroupName="Sort" FontSize="14" Margin="5" Checked="RButtonDown_Checked"/>
            </WrapPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Name="TBCount" FontSize="14" Margin="5"/>
            </StackPanel>
        </StackPanel>

        <ListView Name="ProductListView" Grid.Row="1" Background="White">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Image Margin="5" Grid.Column="0" Grid.RowSpan="4" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image.Source>
                                <Binding Path="MainImagePath">
                                    <Binding.TargetNullValue>
                                        /Images/ЧудоОбувь.png
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>
                        <!--Производитель + Название-->
                        <TextBlock Text="{Binding ProductName}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap" FontWeight="Bold"></TextBlock>
                        <TextBlock Text="{Binding ProductName}" Grid.Column="2" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap" FontWeight="Bold"></TextBlock>
                        <!--Категория-->
                        <TextBlock Text="{Binding CategorY, StringFormat=Категория: {0}}" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" FontSize="20"></TextBlock>
                        <!--Количество-->
                        <TextBlock Text="{Binding CategorY, StringFormat=Количество: {0}}" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Left" FontSize="13"></TextBlock>
                        <!--Состав-->
                        <TextBlock Text="{Binding ProductComposition, StringFormat=Состав: {0}}" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="3" HorizontalAlignment="Left" FontSize="15" TextWrapping="Wrap"></TextBlock>

                        <!--Цена-->
                        <TextBlock Text="{Binding ProductCost, StringFormat=Цена &#10142; {0}}" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left" FontSize="20" TextWrapping="Wrap" FontWeight="Bold"></TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="3" Margin="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#x25C0;" Click="BtnPrev_Click" Width="30" Height="30" Margin="5" FontSize="15" FontWeight="Bold"/>
                <TextBlock Name="TBPage" VerticalAlignment="Center" Margin="10" FontSize="20" FontWeight="Bold" Background="White"/>
                <Button Content="&#x25B6;" Click="BtnNext_Click" Width="30" Height="30" Margin="5" FontSize="15" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
