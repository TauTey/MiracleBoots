<Page x:Class="TradingOrganization.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TradingOrganization"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="1200"
      Title="Профиль"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <Grid Margin="28,8,28,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Профиль" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="Личная информация и настройки аккаунта"
                           Style="{StaticResource PageSubtitleText}"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="370"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Аватар и действия -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}"
                        Padding="24" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Width="200" Height="200" CornerRadius="100"
                                Background="#E8F8FB" ClipToBounds="True"
                                HorizontalAlignment="Center">
                            <Image x:Name="AvatarImage" Stretch="UniformToFill"/>
                        </Border>

                        <TextBlock x:Name="FioText" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,16,0,0"/>
                        <TextBlock x:Name="RoleText" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>

                        <Button x:Name="ChangePhotoBtn" Content="Изменить фото"
                                Style="{StaticResource NavButton}"
                                HorizontalAlignment="Center" Margin="0,22,0,0"
                                Click="ChangePhoto_Click"/>

                        <Button x:Name="EditDataBtn" Content="Редактировать данные"
                                Style="{StaticResource NavButton}"
                                HorizontalAlignment="Center" Margin="0,10,0,0"
                                Visibility="Collapsed"
                                Click="EditData_Click"/>

                        <Button x:Name="RequestChangeBtn" Content="Запросить изменение данных"
                                Style="{StaticResource NavButton}"
                                HorizontalAlignment="Center" Margin="0,10,0,0"
                                FontSize="13.5" Padding="16,9"
                                Visibility="Collapsed"
                                Click="RequestChange_Click"/>

                        <Button x:Name="LogoutBtn" Content="Выйти из аккаунта"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Center" Margin="0,10,0,0"
                                Click="Logout_Click"/>
                    </StackPanel>
                </Border>

                <!-- Данные -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0">

                    <Border Style="{StaticResource CardBorder}" Padding="26"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Личные данные" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Сведения, которые хранятся в базе данных"
                                       Style="{StaticResource MutedText}" Margin="0,4,0,14"/>

                            <ItemsControl x:Name="InfoList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="0,0,0,1" Padding="0,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="230"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Название}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Значение}"
                                                           FontSize="15"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Учётные данные -->
                    <Border Style="{StaticResource CardBorder}" Padding="26" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Учётные данные" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Логин и пароль скрыты от посторонних глаз"
                                       Style="{StaticResource MutedText}" Margin="0,4,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Логин" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="LoginValue" Grid.Column="1"
                                           FontSize="15" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Пароль" Grid.Row="1" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock x:Name="PasswordValue" Grid.Row="1" Grid.Column="1"
                                           FontSize="15" Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" Margin="0,12,0,0"/>
                                <Button x:Name="ShowCredentialsBtn" Grid.Column="2" Grid.RowSpan="2"
                                        Content="Показать"
                                        Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Center" Margin="12,0,0,0"
                                        FontSize="13" Padding="14,8"
                                        Click="ShowCredentials_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Письма по заявкам -->
                    <Border x:Name="LettersCard" Style="{StaticResource CardBorder}"
                            Padding="26" Margin="0,16,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Сообщения" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Ответы заведующего по вашим заявкам"
                                       Style="{StaticResource MutedText}" Margin="0,4,0,6"/>

                            <StackPanel x:Name="LettersStack"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
