<Page x:Class="TradingOrganization.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TradingOrganization"
      mc:Ignorable="d"
      d:DesignHeight="650" d:DesignWidth="1200"
      Title="Главная"
      Background="Transparent">

    <Page.Resources>
        <!-- Сотрудник с кнопкой редактирования (для заведующего) -->
        <DataTemplate x:Key="EditableStaffTemplate">
            <Border Style="{StaticResource CardBorder}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                            Background="#E8F8FB" ClipToBounds="True"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image Source="{Binding Фотография}" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ФИО}" FontSize="16.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ДолжностьНазвание}" Style="{StaticResource MutedText}"
                                   Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding ПолНазвание}" Style="{StaticResource MutedText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Дата рождения" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding ДатаРожденияТекст}" Style="{StaticResource ValueText}"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ВозрастТекст}" Style="{StaticResource MutedText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Место жительства" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding City}" Style="{StaticResource ValueText}"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Address}" Style="{StaticResource MutedText}"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="4" Content="Редактировать"
                            Style="{StaticResource GhostButton}"
                            VerticalAlignment="Center" Margin="12,0,0,0"
                            FontSize="13" Padding="14,8"
                            Click="StaffEdit_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Пользователь с кнопкой редактирования (для директора) -->
        <DataTemplate x:Key="UserAdminTemplate">
            <Border Style="{StaticResource CardBorder}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                            Background="#E8F8FB" ClipToBounds="True"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image Source="{Binding Фотография}" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ФИО}" FontSize="16.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding РольНазвание}" FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding ДолжностьНазвание}" Style="{StaticResource MutedText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Дата рождения" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding ДатаРожденияТекст}" Style="{StaticResource ValueText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Торговая точка" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding ТочкаОписание}" Style="{StaticResource ValueText}"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="4" Content="Редактировать"
                            Style="{StaticResource GhostButton}"
                            VerticalAlignment="Center" Margin="12,0,0,0"
                            FontSize="13" Padding="14,8"
                            Click="UserEdit_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Заявка на изменение данных -->
        <DataTemplate x:Key="RequestTemplate">
            <Border Style="{StaticResource CardBorder}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="{Binding User.ФИО}" FontSize="16.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0">
                            <Run Text="Заявка №"/>
                            <Run Text="{Binding RequestID, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding СозданТекст, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Message}" Style="{StaticResource ValueText}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding ManagerComment}" FontSize="12.5"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding СтатусНазвание}" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                    Visibility="{Binding ДействияВидимость}">
                            <Button Content="Изменить данные"
                                    Style="{StaticResource NavButton}"
                                    FontSize="13" Padding="14,8"
                                    Click="RequestEdit_Click"/>
                            <Button Content="Отклонить"
                                    Style="{StaticResource DangerButton}"
                                    FontSize="13" Padding="14,8" Margin="6,0,0,0"
                                    Click="RequestReject_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Заявка на заказ поставщику (для заведующего — без действий) -->
        <DataTemplate x:Key="OrderRequestTemplate">
            <Border Style="{StaticResource CardBorder}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="{Binding ПоставщикНазвание}" FontSize="16.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0">
                            <Run Text="Заявка №"/>
                            <Run Text="{Binding OrderRequestID, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding СозданТекст, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource ValueText}" Margin="0,8,0,0">
                            <Run Text="{Binding ProductName, Mode=OneWay}"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding КоличествоТекст, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding ЦенаТекст, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding DirectorComment}" FontSize="12.5"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding КомментарийВидимость, Mode=OneWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding СтатусНазвание}" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{Binding СтатусЦвет, Mode=OneWay}"
                                   HorizontalAlignment="Right"/>
                        <Button Content="Редактировать"
                                Style="{StaticResource NavButton}"
                                FontSize="13" Padding="14,8" Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                Visibility="{Binding РедактироватьВидимость, Mode=OneWay}"
                                Click="OrderRequestEdit_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Заявка на заказ поставщику (для директора — с решением) -->
        <DataTemplate x:Key="OrderRequestReviewTemplate">
            <Border Style="{StaticResource CardBorder}" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="{Binding ПоставщикНазвание}" FontSize="16.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0">
                            <Run Text="Заявка №"/>
                            <Run Text="{Binding OrderRequestID, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding СозданТекст, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource ValueText}" Margin="0,8,0,0">
                            <Run Text="{Binding ProductName, Mode=OneWay}"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding КоличествоТекст, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding ЦенаТекст, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                            <Run Text="{Binding ТочкаОписание, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding ЗаведующийФИО, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding DirectorComment}" FontSize="12.5"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding КомментарийВидимость, Mode=OneWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding СтатусНазвание}" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{Binding СтатусЦвет, Mode=OneWay}"
                                   HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding ДействияВидимость}">
                            <Button Content="Подтвердить"
                                    Style="{StaticResource NavButton}"
                                    FontSize="13" Padding="14,8"
                                    Click="OrderRequestApprove_Click"/>
                            <Button Content="Отклонить"
                                    Style="{StaticResource DangerButton}"
                                    FontSize="13" Padding="14,8" Margin="6,0,0,0"
                                    Click="OrderRequestReject_Click"/>
                        </StackPanel>
                        <Button Content="Отменить заявку"
                                Style="{StaticResource DangerButton}"
                                FontSize="13" Padding="14,8" Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                Visibility="{Binding ОтменаВидимость, Mode=OneWay}"
                                Click="OrderRequestCancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="28,8,28,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и поиск -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleText}"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleText}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Поиск:" Style="{StaticResource ValueText}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Width="250" Height="38"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="CountText" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="90"/>
            </StackPanel>
        </Grid>

        <!-- Письмо сотруднику -->
        <Border x:Name="LetterBanner" Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Background="#EEF0FF" BorderBrush="{StaticResource NavBrush}"
                Padding="16,12" Margin="0,12,0,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Сообщение от заведующего" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock x:Name="LetterText" FontSize="14.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="LetterActionBtn" Grid.Column="1" Content="Открыть"
                        Style="{StaticResource NavButton}"
                        VerticalAlignment="Center" Margin="16,0,0,0"
                        FontSize="13.5" Padding="16,8"
                        Click="LetterActionBtn_Click"/>
            </Grid>
        </Border>

        <!-- Переключатель списков -->
        <Grid Grid.Row="2" Margin="0,16,0,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="StaffNavBtn" Content="Сотрудники"
                        Style="{StaticResource NavButton}" Click="StaffNavBtn_Click"/>
                <Button x:Name="OrdersNavBtn" Content="Заказы поставщикам"
                        Style="{StaticResource NavButton}" Click="OrdersNavBtn_Click"/>
                <Button x:Name="PointsNavBtn" Content="Торговые точки"
                        Style="{StaticResource NavButton}" Click="PointsNavBtn_Click"/>
                <Button x:Name="UsersNavBtn" Content="Пользователи"
                        Style="{StaticResource NavButton}" Click="UsersNavBtn_Click"/>
                <Button x:Name="RequestsNavBtn" Content="Заявки"
                        Style="{StaticResource NavButton}" Click="RequestsNavBtn_Click"/>
                <Button x:Name="OrderRequestsNavBtn" Content="Заявки на заказы"
                        Style="{StaticResource NavButton}" Click="OrderRequestsNavBtn_Click"/>
            </StackPanel>

            <Button x:Name="NewOrderRequestBtn" Content="Новая заявка на заказ"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    FontSize="13.5" Padding="16,9"
                    Visibility="Collapsed"
                    Click="NewOrderRequestBtn_Click"/>
        </Grid>

        <!-- Списки -->
        <Grid Grid.Row="3">
            <ListView x:Name="StaffList" ItemTemplate="{StaticResource EditableStaffTemplate}"/>
            <ListView x:Name="OrdersList" ItemTemplate="{StaticResource OrderTemplate}"/>
            <ListView x:Name="PointsList" ItemTemplate="{StaticResource PointTemplate}"
                      MouseDoubleClick="PointsList_MouseDoubleClick"/>
            <ListView x:Name="UsersList" ItemTemplate="{StaticResource UserAdminTemplate}"/>
            <ListView x:Name="RequestsList" ItemTemplate="{StaticResource RequestTemplate}"/>
            <ListView x:Name="OrderRequestsList" ItemTemplate="{StaticResource OrderRequestTemplate}"/>
            <TextBlock x:Name="EmptyText" Text="Ничего не найдено"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="17" Foreground="{StaticResource MutedBrush}"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>
