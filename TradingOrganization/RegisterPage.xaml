<Page x:Class="TradingOrganization.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TradingOrganization"
      mc:Ignorable="d"
      d:DesignHeight="760" d:DesignWidth="1200"
      Title="Регистрация"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <Grid Margin="28,8,28,8" HorizontalAlignment="Center" Width="980">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Регистрация" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="Новый аккаунт сотрудника торговой точки"
                           Style="{StaticResource PageSubtitleText}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}"
                    Padding="28" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Фамилия" Style="{StaticResource FieldLabelText}"/>
                            <TextBox x:Name="LastNameBox" Height="40"/>

                            <TextBlock Text="Имя" Style="{StaticResource FieldLabelText}" Margin="0,12,0,5"/>
                            <TextBox x:Name="FirstNameBox" Height="40"/>

                            <TextBlock Text="Отчество" Style="{StaticResource FieldLabelText}" Margin="0,12,0,5"/>
                            <TextBox x:Name="PatronymicBox" Height="40"/>

                            <TextBlock Text="Дата рождения" Style="{StaticResource FieldLabelText}" Margin="0,12,0,5"/>
                            <DatePicker x:Name="BirthDatePicker" Height="40"/>

                            <TextBlock Text="Пол" Style="{StaticResource FieldLabelText}" Margin="0,12,0,5"/>
                            <ComboBox x:Name="GenderBox" Height="40"/>
                        </StackPanel>

                        <!-- Правая колонка -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Город" Style="{StaticResource FieldLabelText}"/>
                            <TextBox x:Name="CityBox" Height="40"/>

                            <TextBlock Text="Адрес проживания" Style="{StaticResource FieldLabelText}" Margin="0,12,0,5"/>
                            <TextBox x:Name="AddressBox" Height="40"/>

                            <TextBlock Text="Логин" Style="{StaticResource FieldLabelText}" Margin="0,12,0,5"/>
                            <TextBox x:Name="LoginBox" Height="40"/>

                            <TextBlock Text="Пароль" Style="{StaticResource FieldLabelText}" Margin="0,12,0,5"/>
                            <PasswordBox x:Name="PasswordBox" Height="40"/>

                            <TextBlock Text="Повторите пароль" Style="{StaticResource FieldLabelText}" Margin="0,12,0,5"/>
                            <PasswordBox x:Name="PasswordAgainBox" Height="40"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Должность" Style="{StaticResource FieldLabelText}" Margin="0,16,0,5"/>
                    <ComboBox x:Name="PositionBox" Height="40" DisplayMemberPath="Name"/>

                    <TextBlock Text="Торговая точка" Style="{StaticResource FieldLabelText}" Margin="0,12,0,5"/>
                    <ComboBox x:Name="StoreBox" Height="40" DisplayMemberPath="Подпись"/>

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}"
                               FontSize="13.5" TextWrapping="Wrap" Margin="0,14,0,0"
                               Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="RegisterBtn" Content="Зарегистрироваться"
                                Style="{StaticResource NavButton}"
                                FontSize="15" Padding="24,11"
                                Click="RegisterBtn_Click"/>
                        <Button x:Name="BackBtn" Content="Назад ко входу"
                                Style="{StaticResource GhostButton}"
                                FontSize="15" Padding="20,10"
                                Click="BackBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
