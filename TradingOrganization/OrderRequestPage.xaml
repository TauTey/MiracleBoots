<Page x:Class="TradingOrganization.OrderRequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TradingOrganization"
      mc:Ignorable="d"
      d:DesignHeight="760" d:DesignWidth="1200"
      Title="Заявка на заказ поставщику"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <Grid Margin="28,8,28,8" HorizontalAlignment="Center" Width="980">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Заявка на заказ поставщику" Style="{StaticResource PageTitleText}"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleText}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}"
                    Padding="28" Margin="0,16,0,0">
                <StackPanel>
                    <!-- Шаг 1: выбор поставщика -->
                    <StackPanel x:Name="SupplierStep">
                        <TextBlock Text="Поставщик" Style="{StaticResource FieldLabelText}"/>
                        <ComboBox x:Name="SupplierBox" Height="42" Margin="0,6,0,0"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="SupplierBox_SelectionChanged"/>
                        <TextBlock x:Name="SupplierInfoText" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="Collapsed"/>

                        <TextBlock x:Name="RecipientText" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,16,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="NextBtn" Content="Далее"
                                    Style="{StaticResource NavButton}"
                                    FontSize="15" Padding="24,11"
                                    Click="NextBtn_Click"/>
                            <Button x:Name="CancelStepBtn" Content="Отмена"
                                    Style="{StaticResource GhostButton}"
                                    FontSize="15" Padding="20,10" Margin="8,0,0,0"
                                    Click="CancelBtn_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Шаг 2: состав заявки -->
                    <StackPanel x:Name="FormStep" Visibility="Collapsed">
                        <Border Background="#F2F5FF" BorderBrush="{StaticResource NavBrush}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Выбранный поставщик"
                                               Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="SupplierNameText" FontSize="15.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="0,3,0,0"/>
                                    <TextBlock x:Name="SupplierDetailsText"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="Изменить"
                                        Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Center" Margin="12,0,0,0"
                                        FontSize="13" Padding="14,8"
                                        Click="ChangeSupplierBtn_Click"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Дата заявки" Style="{StaticResource FieldLabelText}"
                                   Margin="0,18,0,6"/>
                        <TextBlock x:Name="DateText" Style="{StaticResource ValueText}"/>

                        <TextBlock Text="Товар" Style="{StaticResource FieldLabelText}"
                                   Margin="0,16,0,6"/>
                        <TextBox x:Name="ProductBox" Height="40" MaxLength="100"
                                 ToolTip="Наименование товара"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Количество"
                                       Style="{StaticResource FieldLabelText}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Единица измерения"
                                       Style="{StaticResource FieldLabelText}"/>
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Цена заказа, ₽"
                                       Style="{StaticResource FieldLabelText}"/>

                            <TextBox Grid.Row="1" Grid.Column="0" x:Name="QuantityBox"
                                     Height="40" Margin="0,6,0,0" MaxLength="12"
                                     ToolTip="Например: 12 или 2,5"/>
                            <ComboBox Grid.Row="1" Grid.Column="2" x:Name="UnitBox"
                                      Height="40" Margin="0,6,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="4" x:Name="PriceBox"
                                     Height="40" Margin="0,6,0,0" MaxLength="14"
                                     ToolTip="Итоговая сумма заказа"/>
                        </Grid>

                        <TextBlock Text="Количество указывается в штуках, упаковках или в весе. Цена — итоговая сумма заказа."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13.5" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="SendBtn" Content="Отправить директору"
                                    Style="{StaticResource NavButton}"
                                    FontSize="15" Padding="24,11"
                                    Click="SendBtn_Click"/>
                            <Button x:Name="CancelBtn" Content="Отмена"
                                    Style="{StaticResource GhostButton}"
                                    FontSize="15" Padding="20,10"
                                    Click="CancelBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
