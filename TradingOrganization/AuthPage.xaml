<Page x:Class="TradingOrganization.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TradingOrganization"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="Вход в систему"
      Background="Transparent">
    <Grid Margin="28,8,28,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>

        <!-- Приветствие -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,60,0">
            <TextBlock Text="Добро пожаловать!"
                       FontSize="46" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="Единая информационная система торговой организации"
                       FontSize="20" Foreground="#3D4F79" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <TextBlock Margin="0,18,0,0" FontSize="15" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" MaxWidth="640" LineHeight="22">
                Система предназначена для сотрудников, заведующих торговыми точками и директоров.
                После входа вы увидите только те данные, которые соответствуют вашей роли.
            </TextBlock>

            <WrapPanel Margin="0,30,0,0">
                <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="Сотрудник" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Заказы своей точки" Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="Заведующий" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Сотрудники и заказы" Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="210" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Директор" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Торговые точки организации" Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>

        <!-- Форма входа -->
        <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                Padding="30" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Вход в систему"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Укажите свои данные для продолжения"
                           Style="{StaticResource MutedText}" Margin="0,5,0,22"/>

                <TextBlock Text="Логин или налоговый номер"
                           Style="{StaticResource FieldLabelText}"/>
                <TextBox x:Name="LoginBox" Height="42" KeyDown="AuthField_KeyDown"/>

                <TextBlock Text="Пароль"
                           Style="{StaticResource FieldLabelText}" Margin="0,16,0,5"/>
                <PasswordBox x:Name="PasswordBox" Height="42" KeyDown="AuthField_KeyDown"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}"
                           FontSize="13.5" TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="Collapsed"/>

                <Button x:Name="EnterBtn" Content="Войти"
                        Style="{StaticResource NavButton}"
                        Height="46" Margin="0,20,0,0"
                        FontSize="17"
                        Click="EnterBtn_Click"/>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Нет аккаунта?" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="RegisterBtn" Grid.Column="1" Content="Зарегистрироваться"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Right"
                            FontSize="13.5" Padding="14,7"
                            Click="RegisterBtn_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
