<Page x:Class="TradingOrganization.StaffPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TradingOrganization"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="Торговая точка"
      Background="Transparent">

    <Grid Margin="28,8,28,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleText}"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleText}"/>
        </StackPanel>

        <!-- Карточка заведующего -->
        <Border Grid.Row="1" x:Name="ManagerCard"
                Style="{StaticResource CardBorder}"
                Padding="20" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="118" Height="118" CornerRadius="59"
                        Background="#E8F8FB" ClipToBounds="True"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Image Source="{Binding Фотография}" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,24,0">
                    <TextBlock Text="{Binding ФИО}" FontSize="25" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Заведующий торговой точкой"
                               FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,4,0,10"/>

                    <WrapPanel>
                        <StackPanel Margin="0,0,34,0">
                            <TextBlock Text="Дата рождения" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding ДатаРожденияТекст}" Style="{StaticResource ValueText}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Логин" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding Логин}" Style="{StaticResource ValueText}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ВозрастТекст, StringFormat=Возраст: {0}}"
                               Style="{StaticResource ValueText}" HorizontalAlignment="Right"/>
                    <TextBlock Text="Карточка заведующего"
                               Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Переключатель и поиск -->
        <Grid Grid.Row="2" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="StaffNavBtn" Content="Сотрудники"
                        Style="{StaticResource NavButton}" Click="StaffNavBtn_Click"/>
                <Button x:Name="OrdersNavBtn" Content="Заказы поставщикам"
                        Style="{StaticResource NavButton}" Click="OrdersNavBtn_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Поиск:" Style="{StaticResource ValueText}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox" Width="250" Height="38"
                         TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="CountText" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="14,0,0,0" MinWidth="90"/>
            </StackPanel>
        </Grid>

        <!-- Списки -->
        <Grid Grid.Row="3">
            <ListView x:Name="StaffList" ItemTemplate="{StaticResource StaffTemplate}"/>
            <ListView x:Name="OrdersList" ItemTemplate="{StaticResource OrderTemplate}"/>
            <TextBlock x:Name="EmptyText" Text="Ничего не найдено"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="17" Foreground="{StaticResource MutedBrush}"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>
