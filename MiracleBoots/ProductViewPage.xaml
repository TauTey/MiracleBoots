<Page x:Class="MiracleBoots.ProductViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MiracleBoots"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Просмотр модели — ЧудоОбувь" FontFamily="Calibri" Background="#D2F6E7">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Изображение -->
        <Image Grid.Column="0" Source="{Binding ImagePath}"
               Width="280" Height="280" Stretch="Uniform"
               VerticalAlignment="Top" Margin="10"/>
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="{Binding ManufacturerAndName}" FontSize="22" FontWeight="Bold"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding CategoryName, StringFormat='Категория: {0}'}" FontSize="14" Margin="0,5"/>
            <TextBlock Text="{Binding DiscountedPrice, StringFormat='Цена со скидкой: {0:N2} руб.'}" FontSize="14"/>
            <TextBlock Text="{Binding ProductCost, StringFormat='Цена без скидки: {0:N2} руб.'}" FontSize="12"
                       Foreground="Gray"/>
            <TextBlock Text="{Binding Discount, StringFormat='Скидка: {0}%'}" FontSize="12"
                       Foreground="Gray"/>
            <TextBlock Text="{Binding construction, StringFormat='Состав: {0}'}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,5"/>
            <TextBlock Text="{Binding ProductDescription, StringFormat='Описание: {0}'}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,5"/>
            <TextBlock Name="SizeRangeText" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Доступные для заказа размеры:" FontSize="14" Margin="0,10,0,5"/>
            <ListBox Name="SizesListBox" Height="120" DisplayMemberPath="DisplaySize"
                     SelectionChanged="SizesListBox_SelectionChanged"/>
            <TextBlock Name="SelectedSizeInfoText" FontSize="12" Foreground="Gray" Margin="0,5,0,0"/>
            <TextBlock Text="Количество:" FontSize="14" Margin="0,10,0,0"/>
            <TextBox Name="QuantityBox" Width="100" HorizontalAlignment="Left" Text="1"
                     PreviewTextInput="QuantityBox_PreviewTextInput"/>
            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <Button Style="{StaticResource AppButton}" Name="AddToCartButton" Content="Добавить в заказ" Click="AddToCart_Click"/>
                <Button Style="{StaticResource AppButton}" Name="BackToCatalogButton" Content="Вернуться в каталог" Click="Back_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
