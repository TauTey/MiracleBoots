<Page x:Class="MiracleBoots.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MiracleBoots"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация — ЧудоОбувь" FontFamily="Calibri" Background="#D2F6E7">

    <Grid>
        <Border Background="White" CornerRadius="10" Padding="30" Width="380"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Вход в систему" FontSize="26" HorizontalAlignment="Center"
                           Margin="5" FontWeight="Bold"/>
                <TextBlock Text="Введите логин пользователя" FontSize="16"
                           HorizontalAlignment="Center" Margin="5"/>
                <TextBox Name="LoginBox" FontSize="16" Margin="5" Padding="4"/>
                <Button Style="{StaticResource AppButton}" Name="EnterBtn" Content="Войти" Height="32" Margin="5" Click="EnterBtn_Click" FontWeight="Bold"/>
                <TextBlock Text="Не зарегистрированы?" FontSize="15" Margin="10,15,5,5" HorizontalAlignment="Center"/>
                <Button Style="{StaticResource AppButton}" Name="GuestBtn" Content="Войти как гость" Height="32" Margin="5" Click="GuestBtn_Click" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
