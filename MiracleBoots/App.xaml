<Application x:Class="MiracleBoots.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MiracleBoots"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style x:Key="AppButton" TargetType="Button">
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="Width" Value="Auto"></Setter>
            <Setter Property="MinWidth" Value="130"></Setter>
            <Setter Property="Padding" Value="12,0"></Setter>
            <Setter Property="Height" Value="32"></Setter>
            <Setter Property="Background" Value="#70B2AF"></Setter>
            <Setter Property="FontSize" Value="20"></Setter>
        </Style>
    </Application.Resources>
</Application>
