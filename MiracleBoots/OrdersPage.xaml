<Page x:Class="MiracleBoots.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MiracleBoots"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Управление заказами — ЧудоОбувь" FontFamily="Calibri" Background="#D2F6E7"
      Loaded="Page_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Список заказов" FontSize="24" Margin="5"/>
        <TextBlock Grid.Row="1" Text="Двойной щелчок по строке открывает состав заказа."
                   FontSize="13" Foreground="Gray" Margin="5,0,5,5"/>
        <DataGrid Grid.Row="2" Name="OrdersGrid" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" Margin="5"
                  MouseDoubleClick="OrdersGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ Заказа" Binding="{Binding ID_Order}" Width="80"/>
                <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate, StringFormat='dd.MM.yyyy'}" Width="120"/>
                <DataGridTextColumn Header="ФИО клиента" Binding="{Binding UserFullName}" Width="*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat='{}{0:N2} руб.'}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Style="{StaticResource AppButton}" Name="OpenOrderButton" Content="Открыть" Click="OpenOrder_Click"/>
            <Button Style="{StaticResource AppButton}" Name="DeleteOrderButton" Content="Удалить заказ"
                    Click="DeleteOrder_Click" Visibility="Collapsed"/>
            <Button Style="{StaticResource AppButton}" Name="RefreshButton" Content="Обновить" Click="Refresh_Click"/>
        </StackPanel>
    </Grid>
</Page>
