<Page x:Class="MiracleBoots.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MiracleBoots"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="1000"
      Title="Каталог обуви — ЧудоОбувь" FontFamily="Calibri" Background="#D2F6E7" Loaded="Page_Loaded">
    <Grid Background="#D2F6E7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="5">
            <TextBlock Name="FIOTB" FontSize="16" Margin="5"/>
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:" FontSize="16" Margin="5"/>
                <TextBox Name="TBoxSearch" Width="250" FontSize="14" TextChanged="TBoxSearch_TextChanged"/>
                <TextBlock Text="Категория:" FontSize="16" Margin="15,5,5,5"/>
                <ComboBox Name="ComboCategory" Width="180" FontSize="14"
                          SelectionChanged="ComboCategory_SelectionChanged"/>
                <TextBlock Text="Сортировка:" FontSize="16" Margin="15,5,5,5"/>
                <ComboBox Name="ComboSort" Width="200" FontSize="14"
                          SelectionChanged="ComboSort_SelectionChanged">
                    <ComboBoxItem Content="Без сортировки"/>
                    <ComboBoxItem Content="По возрастанию цены"/>
                    <ComboBoxItem Content="По убыванию цены"/>
                </ComboBox>
            </WrapPanel>
            <TextBlock Name="TBCount" FontSize="14" Margin="5"/>
        </StackPanel>
        <ListView Grid.Row="1" Name="ProductsListView" HorizontalContentAlignment="Stretch"
                  Background="White" MouseLeftButtonUp="ProductsListView_MouseLeftButtonUp"
                  IsSynchronizedWithCurrentItem="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <!-- Собственный шаблон без синей подсветки выделения:
                                     цвет карточки задаётся привязкой BackgroundColor. -->
                                <Border Background="Transparent" SnapsToDevicePixels="True">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#1E1E1E"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Background="{Binding BackgroundColor}" Margin="2">
                        <Grid MinHeight="110" Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ManufacturerAndName}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="22"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,10"/>
                            
                            <Image Source="{Binding ImagePath}" Grid.Row="1" Grid.Column="0" Width="90" Height="90"
                                   Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CategoryName, StringFormat='Категория: {0}'}"/>
                                <TextBlock Text="{Binding QuantityText, StringFormat='Количество: {0}'}"/>
                                <TextBlock Text="{Binding construction, StringFormat='Состав: {0}'}" TextWrapping="Wrap"/>
                            </StackPanel>
                           
                            <StackPanel Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DiscountedPrice, StringFormat='{}{0:N2} руб.'}"
                                           FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Discount, StringFormat='Скидка: {0}%'}"
                                           FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
