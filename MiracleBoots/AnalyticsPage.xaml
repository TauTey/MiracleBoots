<Page x:Class="MiracleBoots.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MiracleBoots"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Аналитика продаж — ЧудоОбувь" FontFamily="Calibri" Background="#D2F6E7">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Аналитика продаж" FontSize="26" FontWeight="Bold" Margin="5"/>
            <TextBlock Text="Показатели пересчитываются автоматически при изменении периода."
                       FontSize="13" Foreground="Gray" Margin="5,0,5,5"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="5">
            <TextBlock Text="Период с:" FontSize="16" VerticalAlignment="Center"/>
            <DatePicker Name="StartDatePicker" Width="185" Margin="10,0,0,0" FontSize="14"
                        SelectedDateChanged="DatePicker_SelectedDateChanged"/>
            <TextBlock Text="по:" FontSize="16" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <DatePicker Name="EndDatePicker" Width="185" Margin="10,0,0,0" FontSize="14"
                        SelectedDateChanged="DatePicker_SelectedDateChanged"/>
            <Button Style="{StaticResource AppButton}" Name="ExportBtn" Content="Экспорт в PDF" Margin="30,0,0,0" Click="Export_Click"/>
        </WrapPanel>

        <TextBlock Grid.Row="2" Name="ErrorText" FontSize="14" FontWeight="SemiBold"
                   Foreground="#B00020" Margin="5,0,5,5" Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="5,5,5,10">
            <Border Background="White" CornerRadius="8" Padding="20,12" Margin="0,0,20,0" MinWidth="260">
                <StackPanel>
                    <TextBlock Text="Количество заказов за период" FontSize="14" Foreground="Gray"/>
                    <TextBlock Name="TotalOrdersText" Text="—" FontSize="30" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="20,12" MinWidth="320">
                <StackPanel>
                    <TextBlock Text="Общая сумма продаж" FontSize="14" Foreground="Gray"/>
                    <TextBlock Name="TotalSalesText" Text="—" FontSize="30" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Топ-5 моделей обуви по количеству проданных пар"
                   FontSize="18" FontWeight="SemiBold" Margin="5,0,5,5"
                   VerticalAlignment="Top"/>

        <DataGrid Grid.Row="4" Name="TopModelsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  Margin="5,35,5,5" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Rank}" Width="60"/>
                <DataGridTextColumn Header="Наименование модели" Binding="{Binding Model}" Width="*"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="220"/>
                <DataGridTextColumn Header="Количество пар" Binding="{Binding Pairs}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" Name="PeriodInfoText" FontSize="13" Foreground="Gray"
                   Margin="5,5,5,0" HorizontalAlignment="Left"/>
    </Grid>
</Page>
