<Page x:Class="MiracleBoots.OrderDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MiracleBoots"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Состав заказа — ЧудоОбувь" FontFamily="Calibri" Background="#D2F6E7"
      Unloaded="Page_Unloaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <TextBlock Text="Дата заказа:" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
            <DatePicker Name="OrderDatePicker" Width="150" VerticalAlignment="Center"/>
            <TextBlock Text="Клиент:" VerticalAlignment="Center" FontSize="16" Margin="20,0,10,0"/>
            <ComboBox Name="ClientCombo" Width="320" VerticalAlignment="Center" FontSize="14"
                      DisplayMemberPath="FullName"/>
        </StackPanel>
        <DataGrid Grid.Row="1" Name="OrderItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Модель — производство, размер" Binding="{Binding ProductInfo}" Width="*"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Цена за ед." Binding="{Binding PriceAtOrderTime, StringFormat='{}{0:N2} руб.'}" Width="120"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat='{}{0:N2} руб.'}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Style="{StaticResource AppButton}" Name="DeletePositionButton" Content="Удалить позицию"
                Click="DeletePosition_Click" Grid.Row="2" HorizontalAlignment="Right" Margin="5"
                Visibility="Collapsed"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5, 15, 5, 5">
            <TextBlock Name="TotalAmountText" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Style="{StaticResource AppButton}" Name="SaveButton" Content="Сохранить изменения"
                    Click="Save_Click" Visibility="Collapsed"/>
            <Button Style="{StaticResource AppButton}" Name="BackButton" Content="Назад" Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Page>
